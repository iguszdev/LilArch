general {
    colors = true
    interval = 5
    color_good = "#3fb4ff"
    color_degraded = "#ff9ad9"
    color_bad = "#ff6ec7"
    separator = " 🍭 "
}
order += "wireless _first_"
order += "ethernet _first_"
order += "cpu_usage"
order += "memory"
order += "tztime local"

wireless _first_ {
    format_up = "📶 %essid"
    format_down = "no wifi"
}
ethernet _first_ {
    format_up = "🌐 %ip"
    format_down = "no eth"
}
cpu_usage {
    format = "CPU %usage"
}
memory {
    format = "RAM %used"
    threshold_degraded = "10%"
    format_degraded = "RAM LOW %free"
}
tztime local {
    format = "%H:%M  %d.%m"
}
